{
  "name": "dio-mcp-server",
  "version": "0.1.0",
  "description": "MCP Server for the DIO learning platform — exposes trilha, certificado and desafio tools over stdio or HTTP.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "cross-env MCP_TRANSPORT=http node build/index.js",
    "dev": "tsc --watch"
  },
  "bin": {
    "dio-mcp-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.23.8",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.5.2"
  }
}
